#!/usr/bin/env bash
set -euo pipefail

cmd="${1:-}"
name="${2:-}"

case "${cmd}" in
  info)
    if [[ "${*: -2}" == "--format json" ]]; then
      cat <<JSON
{"info":{"${name}":{"state":"Running","ipv4":["192.168.64.10"]}}}
JSON
    else
      cat <<EOF
Name:           ${name}
State:          Running
IPv4:           192.168.64.10
EOF
    fi
    ;;
  delete)
    if [[ -n "${MOCK_MULTIPASS_LOG:-}" ]]; then
      echo "delete ${name}" >> "${MOCK_MULTIPASS_LOG}"
    fi
    exit 0
    ;;
  stop)
    if [[ -n "${MOCK_MULTIPASS_LOG:-}" ]]; then
      echo "stop ${name}" >> "${MOCK_MULTIPASS_LOG}"
    fi
    exit 0
    ;;
  purge)
    if [[ -n "${MOCK_MULTIPASS_LOG:-}" ]]; then
      echo "purge" >> "${MOCK_MULTIPASS_LOG}"
    fi
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
